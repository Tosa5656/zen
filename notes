C12A7328-F81F-11D2-BA4B-00A0C93EC93B - EFI/Kernel partition GUID
b22def29-88ed-445b-8a1d-2c75c3c423ff - OS partition GUID
0xD480A6 - magic number for boot_info

boot_info structure:
uint32_t magic;
uint32_t size;
uint64_t memory_map_address;
uint64_t memory_map_entries;
uint64_t framebuffer_address;
uint32_t framebuffer_width;
uint32_t framebuffer_height;
uint32_t framebuffer_pitch;
uint8_t framebuffer_bpp;
uint8_t framebuffer_red_mask_shift;
uint8_t framebuffer_green_mask_shift;
uint8_t framebuffer_blue_mask_shift;
uint8_t _reserved1[4];
uint64_t acpi_rsdp_address;
uint64_t smbios_address;

memory_map_entry:
uint64_t base_address;
uint64_t length;
uint32_t type;
uint32_t extended_attributes;
